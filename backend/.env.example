# Modelo de configuração do backend CodeGuild.
#
#   cd backend
#   cp .env.example .env
#
# Depois edite backend/.env com os valores da sua máquina.
# backend/.env é LOCAL e NÃO deve ser versionado (já está no .gitignore).

# Conexão com o PostgreSQL (obrigatória).
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/codeguild_db

# Chave usada para assinar os tokens JWT de login.
# Use um valor longo e aleatório, por exemplo o resultado de:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_SECRETA_FORTE

# Integração GitHub REST API - uso futuro
# Nenhum código lê estas variáveis ainda; elas serão habilitadas na task de integração GitHub.
# O token é opcional. Nunca coloque um token real neste arquivo.
# GITHUB_API_URL=https://api.github.com
# GITHUB_TOKEN=
